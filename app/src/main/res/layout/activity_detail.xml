<?xml version="1.0" encoding="utf-8"?>
<!-- Detail Screen: full info for single food spot -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name" />
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Spot Name -->
            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <!-- Location -->
            <TextView
                android:id="@+id/labelLocation"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_location" />
            
            <TextView
                android:id="@+id/detailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_marginTop="2dp" />

            <!-- Rating -->
            <TextView
                android:id="@+id/labelRating"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_rating" />
            
            <RatingBar
                android:id="@+id/detailRatingBar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5"
                android:layout_marginTop="4dp" />

            <!-- Last Visit -->
            <TextView
                android:id="@+id/labelLastVisit"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_last_visit" />
            <TextView
                 android:id="@+id/detailLastVisit"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:textSize="15sp"
                 android:layout_marginTop="2dp" />

            <!-- Visited Switch -->
            <TextView
                android:id="@+id/labelVisited"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_visited" />
            
            <Switch
                android:id="@+id/detailVisitedSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:enabled="false" />

            <!-- About -->
            <TextView
                android:id="@+id/labelDescription"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_description" />

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Personal Review -->
            <TextView
                android:id="@+id/labelReview"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_review" />
            
            <TextView
                android:id="@+id/detailReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.4"
                android:textStyle="italic"
                android:paddingBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>