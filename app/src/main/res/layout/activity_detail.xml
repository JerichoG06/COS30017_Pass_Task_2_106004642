<?xml version="1.0" encoding="utf-8"?>
<!-- Detail Screen: editable form for a single food spot -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name" />
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Spot Name -->
            <TextView
                android:id="@+id/labelName"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_name" />

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/errorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#d11919"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Location -->
            <TextView
                android:id="@+id/labelLocation"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_location" />

            <EditText
                android:id="@+id/editLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/errorLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#d11919"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Rating -->
            <TextView
                android:id="@+id/labelRating"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_rating" />
            
            <RatingBar
                android:id="@+id/detailRatingBar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:layout_marginTop="4dp" />

            <!-- Last Visit -->
            <TextView
                android:id="@+id/labelLastVisit"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_last_visit" />

            <EditText
                android:id="@+id/editLastVisit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:hint="@string/hint_tap_date"
                android:layout_marginTop="4dp"
                android:inputType="none"
                android:cursorVisible="false" />

            <TextView
                android:id="@+id/errorDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#d11919"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Visited Switch -->
            <TextView
                android:id="@+id/labelVisited"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_visited" />

            <Switch
                android:id="@+id/detailVisitedSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- About -->
            <TextView
                android:id="@+id/labelDescription"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_description" />

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Personal Review -->
            <TextView
                android:id="@+id/labelReview"
                style="@style/DetailSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_review" />

            <EditText
                android:id="@+id/editReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:gravity="top"
                android:layout_marginTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/errorReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#d11919"
                android:textSize="12sp"
                android:visibility="gone"
                android:paddingBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>